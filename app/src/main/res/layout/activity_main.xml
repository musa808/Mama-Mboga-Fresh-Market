<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FAF7EF">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mama Mboga Fresh Market"
        android:textSize="25sp"
        android:textStyle="bold"
        android:textColor="#0E5B3A"
        android:gravity="center"
        android:padding="10dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Fresh vegetables at affordable prices!"
        android:textSize="15sp"
        android:gravity="center"
        android:textColor="#555555"
        android:paddingBottom="12dp" />

    <TextView
        android:id="@+id/txtCartTotal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cart: 0 items | Total: KSh 0"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#0E5B3A"
        android:padding="10dp" />

    <ListView
        android:id="@+id/listVegetables"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#DDDDDD"
        android:dividerHeight="1dp" />

    <Button
        android:id="@+id/btnWhatsApp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Order via WhatsApp"
        android:backgroundTint="#25D366"
        android:textColor="#FFFFFF" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Instagram | Facebook | X"
        android:gravity="center"
        android:textColor="#0E5B3A"
        android:padding="12dp" />

</LinearLayout>